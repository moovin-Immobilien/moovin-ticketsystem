# Datenbank (Supabase: Connection Pooler, Transaction Mode, Port 6543)
DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres
APP_URL=https://tickets.example.vercel.app

# Claude (leer = Demo-Modus mit Stichwortregeln)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DRAFT=claude-sonnet-5-5

# moovin-API (Prototyp: zeigt auf die Attrappe in dieser App)
MOOVIN_API_URL=
MOOVIN_API_KEY_ID=proto-1
MOOVIN_API_SECRET=mind-32-zufaellige-zeichen
# Nur Attrappe: akzeptierte Schlüssel "id:secret,id2:secret2" (Default: proto-1:MOOVIN_API_SECRET)
MOCK_MOOVIN_KEYS=

# Inbound-Webhook (?token=… oder Basic-Auth-Passwort)
INBOUND_WEBHOOK_TOKEN=mind-32-zufaellige-zeichen
INBOUND_ADDRESS=mieter@moovin.de
# authserv-id(s) des eigenen Empfangsdienstes, z. B. "inbound.postmarkapp.com" (leer = nur oberster Header zählt)
TRUSTED_AUTHSERV_IDS=

# Mail-Dienst für Eingang (Webhook-Format) und Versand: brevo | postmark (ohne Zugangsdaten wird nur simuliert)
MAIL_PROVIDER=brevo
BREVO_API_KEY=
POSTMARK_SERVER_TOKEN=
MAIL_FROM=moovin Vermietung <mieter@moovin.de>

# Login: Google Workspace (Scopes openid, email, profile). Weiterleitungs-URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LOGIN_DOMAIN=moovin.de
# Übergang: gilt nur, solange GOOGLE_CLIENT_ID/SECRET fehlen
PROTOTYPE_PASSWORD=

# Täglicher Cron (/api/cron/daily) – Vercel sendet Authorization: Bearer <CRON_SECRET>
CRON_SECRET=mind-32-zufaellige-zeichen

# moovin-Anbindung: an (Standard) | aus = Livetest ohne moovin-API (Schalter unter Team → Objekte überschreibt das)
MOOVIN_API_MODE=an

# Zoho CRM, nur lesend (Objekt → AM). Optional: einfacher über „Zoho verbinden“ unter Team → Objekte.
# Self Client, Scopes: ZohoCRM.coql.READ,ZohoCRM.modules.deals.READ,ZohoCRM.users.READ
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
# ZOHO_API_BASE=https://www.zohoapis.eu
